{
  "schema": "rustode-bench-app-driver/2",
  "target": "app",
  "measure": "startup",
  "cache": "cold",
  "settle_s": 0,
  "timeout_is_result": false,
  "qa_root": "<qa>",
  "playwright_core": "<qa>/../node_modules/playwright-core",
  "out_dir": "<runs>/2026-11-23-120921-startup-cold/app",
  "profiles_root": "<copies>/rustode-bench-app.4b10fbc98d79f025/profiles",
  "fixture": "<runs>/2026-11-23-120921-startup-cold/fixtures/startup-cold.txt",
  "first_line": "00000001 the quick brown fox jumps over the lazy dog the quick brown fox jumps.",
  "cdp_port": 9333,
  "trace": true,
  "min_available_mb": 2000,
  "evict_script": "<clone>/bench/evict.py",
  "settings": "<clone>/bench/app/settings.json",
  "warmup": 0,
  "repetitions": 20,
  "timeout_ms": 60000,
  "poll_ms": 10,
  "app_command": [
    "systemd-run",
    "--user",
    "--scope",
    "--quiet",
    "-p",
    "MemoryMax=3G",
    "-p",
    "MemorySwapMax=1G",
    "--",
    "<copies>/rustode-bench-app.4b10fbc98d79f025/VSCode-linux-x64/codium",
    "--user-data-dir={profile}/ud",
    "--extensions-dir={profile}/ext",
    "--shared-data-dir={profile}/shared",
    "--disable-telemetry",
    "--disable-workspace-trust",
    "--remote-debugging-port=9333",
    "--new-window",
    "<runs>/2026-11-23-120921-startup-cold/fixtures/startup-cold.txt"
  ],
  "sampler_command": [
    "python3",
    "-I",
    "<qa>/suite/collectors/sampler.py",
    "--match",
    "{profile_re}/ud",
    "--interval",
    "1",
    "--out",
    "{rep_dir}/sampler.jsonl",
    "--abort-below-mb",
    "700",
    "--abort-psi",
    "40"
  ],
  "env": {
    "GALLIUM_DRIVER": "llvmpipe",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "VK_ICD_FILENAMES": "/nonexistent",
    "__EGL_VENDOR_LIBRARY_FILENAMES": "/usr/share/glvnd/egl_vendor.d/50_mesa.json",
    "__GLX_VENDOR_LIBRARY_NAME": "mesa"
  },
  "evict_paths": [
    "<copies>/rustode-bench-app.4b10fbc98d79f025/VSCode-linux-x64"
  ],
  "cache_reference": "<copies>/rustode-bench-app.4b10fbc98d79f025/VSCode-linux-x64/codium"
}
